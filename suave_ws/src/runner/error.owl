<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://metacontrol.org/tomasys"
         xmlns="http://metacontrol.org/tomasys#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:swrl2="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#">

<owl:Ontology rdf:about="http://metacontrol.org/tomasys">
  <owl:imports rdf:resource="http://ros/mros"/>
  <owl:imports rdf:resource="http://www.metacontrol.org/suave"/>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#binding_component">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Binding"/>
  <rdfs:range rdf:resource="#Component"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#binding_role">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Binding"/>
  <rdfs:range rdf:resource="#Role"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#fd_error_log">
  <rdfs:domain rdf:resource="#FunctionDesign"/>
  <rdfs:range rdf:resource="#Objective"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">contains all objectives for which an FG instance of the FD has failed</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasBindings">
  <rdfs:domain rdf:resource="#FunctionGrounding"/>
  <rdfs:range rdf:resource="#Binding"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasNFR">
  <rdfs:domain rdf:resource="#Objective"/>
  <rdfs:range rdf:resource="#QAvalue"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasQAestimation">
  <rdfs:domain rdf:resource="#FunctionDesign"/>
  <rdfs:range rdf:resource="#QAvalue"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasQAvalue">
  <rdfs:domain rdf:resource="#FunctionGrounding"/>
  <rdfs:range rdf:resource="#QAvalue"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isQAtype">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#QAvalue"/>
  <rdfs:range rdf:resource="#QualityAttributeType"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#requiresO">
  <rdfs:domain rdf:resource="#FunctionGrounding"/>
  <rdfs:range rdf:resource="#Objective"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A FunctionGrounding may need an Objective to be solved (by someone else) as a requirement to realise its target Objective</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#roleDef">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Role"/>
  <rdfs:range rdf:resource="#Component"/>
  <rdfs:range rdf:resource="#ComponentSpecification"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a Role consists of the definition of a component specification for a Function Design</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#roles">
  <rdfs:domain rdf:resource="#FunctionDesign"/>
  <rdfs:range rdf:resource="#Role"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Function Design consists of roles</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#solvesF">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#FunctionDesign"/>
  <rdfs:range rdf:resource="#Function"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a FunctionDesign solves a Function</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#solvesO">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#FunctionGrounding"/>
  <rdfs:range rdf:resource="#Objective"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A FunctionGrounding is realising an Objective</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#typeC">
  <rdfs:domain rdf:resource="#Component"/>
  <rdfs:range rdf:resource="#ComponentClass"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#typeF">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Objective"/>
  <rdfs:range rdf:resource="#Function"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relates a FunctionGrounding/Objective with a FunctionDesign/Function</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#typeFD">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#FunctionGrounding"/>
  <rdfs:range rdf:resource="#FunctionDesign"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#b_status">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Binding"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#c_status">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Component"/>
  <rdfs:domain rdf:resource="#ComponentState"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:oneOf>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FALSE</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RECOVERED</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRUE</rdf:first>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
      </owl:oneOf>
    </rdfs:Datatype>
  </rdfs:range>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational status of a component. For the moment "false"="ERROR", later we can expand the status to an enumeration</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#cc_availability">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ComponentClass"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">there is engineering information about a Component Class that may dy-
namically vary during system operation, and that is the availability [0, 1] of that type of component. For example, a sensor can be restarted/re-deployed to fix a wrong initial configuration of one of its parameters. However, no matter what reconfiguration we may carry, if there is only one physical sensor in the system, and it is broken, the component instance will not work: it is unavailable.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#cc_unique">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ComponentClass"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">if a Component Class is unique, then only a single instance may exist, and if in error, then the Class becomes unavailable</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#cspec_availability">
  <rdfs:domain rdf:resource="#ComponentSpecification"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A particular ComponentSpecification might not be available.
However, this does not mean that other Configurations of that component are not available (i.e. the ComponentClass is unavailable)
Example: the Yumi configuration with two arms might not be available, but it may be available single-arm</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#fd_efficacy">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#FunctionDesign"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#fd_realisability">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#FunctionDesign"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#fg_status">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#FunctionGrounding"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:oneOf>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IN_ERROR_COMPONENT</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IN_ERROR_FR</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IN_ERROR_NFR</rdf:first>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
      </owl:oneOf>
    </rdfs:Datatype>
  </rdfs:range>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#QAvalue"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#o_always_improve">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Objective"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#o_status">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Objective"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:oneOf>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IN_ERROR_COMPONENT</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IN_ERROR_FR</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IN_ERROR_NFR</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IN_PROGRESS</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UNGROUNDED</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UNREACHABLE</rdf:first>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
      </owl:oneOf>
    </rdfs:Datatype>
  </rdfs:range>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#o_updatable">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
